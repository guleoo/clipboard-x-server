{
  "name": "clipboard-x-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "start": "bun run --cwd server start",
    "dev:server": "bun run --cwd server dev",
    "dev:web": "bun run --cwd web dev",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "test": "bun run --parallel --filter '*' test",
    "test:network": "bun run --filter '@clipboard-x/server' test:network",
    "build": "bun run build.ts",
    "compile": "bun run build.ts --compile",
    "openapi:check": "bun run --cwd server openapi:check",
    "audit:objects": "bun run --cwd server audit:objects",
    "gc:objects": "bun run --cwd server gc:objects",
    "benchmark": "bun run --filter '@clipboard-x/server' benchmark",
    "audit:licenses": "bun run scripts/licenses.ts"
  }
}
