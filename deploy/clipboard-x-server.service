[Unit]
Description=Clipboard X Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipboard-x
Group=clipboard-x
WorkingDirectory=/opt/clipboard-x-server
ExecStart=/opt/clipboard-x-server/clipboard-x-server --config /var/lib/clipboard-x-server/config.yaml
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clipboard-x-server
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
