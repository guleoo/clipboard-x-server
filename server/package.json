{
  "name": "@clipboard-x/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run db:migrate && bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "APP_ENV=test bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/db/migrate.ts",
    "build": "bun run build.ts",
    "compile": "bun run build.ts --compile",
    "openapi": "bun run scripts/openapi.ts",
    "audit:objects": "bun run scripts/objects.ts audit",
    "gc:objects": "bun run scripts/objects.ts gc",
    "benchmark": "bun run scripts/benchmark.ts"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@standard-community/standard-json": "0.3.6",
    "@standard-community/standard-openapi": "0.2.10",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "hono-openapi": "1.3.2",
    "nanoid": "6.0.1",
    "openapi-types": "12.1.3",
    "temporal-polyfill": "0.3.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "yaml": "2.9.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
