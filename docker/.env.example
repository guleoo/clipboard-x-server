# Server listener inside the container.
CBX_HOST=0.0.0.0
CBX_PORT=28787
# Host port binding. Use 0.0.0.0 and port 443 for direct public HTTPS.
CBX_PUBLISH_HOST=127.0.0.1
CBX_PUBLISH_PORT=28787

CBX_ADMIN_USERNAME=admin
CBX_ADMIN_PASSWORD=
CBX_PUBLIC_ORIGIN=http://127.0.0.1:28787
CBX_COOKIE_SECURE=false

# Leave both paths empty for HTTP. For HTTPS, mount certificates from the host.
CBX_TLS_HOST_DIR=./certs
CBX_TLS_CERT_FILE=
CBX_TLS_KEY_FILE=
