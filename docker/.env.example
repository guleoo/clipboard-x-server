# Host-side published address and port. The container always listens on 0.0.0.0:28787.
CBX_HOST=127.0.0.1
CBX_PORT=28787

CBX_ADMIN_USERNAME=admin
CBX_ADMIN_PASSWORD=
# Optional. Set to the browser-facing HTTPS origin when using a reverse proxy.
CBX_PUBLIC_ORIGIN=
CBX_COOKIE_SECURE=false

# Leave both paths empty for HTTP. For direct HTTPS, use compose.tls.yaml.
CBX_TLS_CERT_FILE=
CBX_TLS_KEY_FILE=

# Only needed with compose.tls.yaml; point to two existing PEM files on the host.
CBX_TLS_CERT_HOST_FILE=
CBX_TLS_KEY_HOST_FILE=
